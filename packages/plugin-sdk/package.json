{
  "name": "@dam-hopper/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./runner-protocol": {
      "types": "./dist/runner-protocol.d.ts",
      "default": "./dist/runner-protocol.js"
    },
    "./worker-sdk": {
      "types": "./dist/worker-sdk.d.ts",
      "default": "./dist/worker-sdk.js"
    },
    "./ui-bridge": {
      "types": "./dist/ui-bridge.d.ts",
      "default": "./dist/ui-bridge.js"
    },
    "./framing": {
      "types": "./dist/framing.d.ts",
      "default": "./dist/framing.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
