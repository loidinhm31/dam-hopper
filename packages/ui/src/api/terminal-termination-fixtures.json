{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "description": "Frozen test fixtures and executable specifications for DamHopper terminal session termination, observation, and numeric join contracts (C1–C5).",
  "maxU64ExactEligibility": [
    {
      "id": "max_u64_exact_eligible_with_unsafe_legacy_number",
      "input": {
        "id": "term-max-u64",
        "incarnationExact": "18446744073709551615",
        "incarnation": 18446744073709551615
      },
      "expected": {
        "eligible": true,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": false,
        "reason": "Max u64 exact string is authoritative; legacy numeric wire literal deserializes as u64 in Rust and rounds to unsafe float in JS without invalidating exact eligibility."
      }
    },
    {
      "id": "u64_boundary_2_pow_53_eligible_with_unsafe_legacy_number",
      "input": {
        "id": "term-boundary-53",
        "incarnationExact": "9007199254740993",
        "incarnation": 9007199254740992
      },
      "expected": {
        "eligible": true,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": false,
        "reason": "2^53 + 1 is valid canonical positive u64; unsafe legacy numeric does not invalidate eligibility."
      }
    }
  ],
  "canonicalExactLegacySafeAgreementAndDisagreement": [
    {
      "id": "canonical_exact_with_safe_legacy_agreement",
      "input": {
        "id": "term-safe-agree",
        "incarnationExact": "42",
        "incarnation": 42
      },
      "expected": {
        "eligible": true,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": true,
        "legacySafeIntegerAgreeing": true,
        "reason": "Positive safe integer agrees losslessly with exact string."
      }
    },
    {
      "id": "canonical_exact_with_safe_legacy_disagreement",
      "input": {
        "id": "term-safe-disagree",
        "incarnationExact": "42",
        "incarnation": 43
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": true,
        "legacySafeIntegerAgreeing": false,
        "reason": "Safe integer 43 disagrees with exact string '42'; safe disagreement strictly rejects."
      }
    },
    {
      "id": "canonical_exact_with_nonpositive_zero_legacy_numeric",
      "input": {
        "id": "term-nonpositive-zero",
        "incarnationExact": "42",
        "incarnation": 0
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": true,
        "legacySafeIntegerAgreeing": false,
        "reason": "Legacy numeric 0 is nonpositive; strictly rejects eligibility."
      }
    },
    {
      "id": "canonical_exact_with_negative_legacy_numeric",
      "input": {
        "id": "term-negative-legacy",
        "incarnationExact": "42",
        "incarnation": -42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": true,
        "isLegacySafeInteger": true,
        "legacySafeIntegerAgreeing": false,
        "reason": "Legacy numeric -42 is negative; strictly rejects eligibility."
      }
    }
  ],
  "malformedOrMissingExactNeverNumericFallback": [
    {
      "id": "missing_exact_never_numeric_fallback",
      "input": {
        "id": "term-missing-exact",
        "incarnationExact": null,
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "reason": "Explicit null incarnationExact never falls back to legacy numeric, even when numeric is safe."
      }
    },
    {
      "id": "absent_exact_field_never_numeric_fallback",
      "input": {
        "id": "term-absent-exact",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "reason": "Omitted incarnationExact field never falls back to legacy numeric, even when numeric is safe."
      }
    },
    {
      "id": "zero_exact_string_rejected",
      "input": {
        "id": "term-zero-exact",
        "incarnationExact": "0",
        "incarnation": 0
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Exact string '0' is not positive; canonical range is 1..18446744073709551615."
      }
    },
    {
      "id": "empty_exact_string_rejected",
      "input": {
        "id": "term-empty-exact",
        "incarnationExact": "",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Empty string is not canonical positive u64."
      }
    },
    {
      "id": "leading_zero_exact_string_rejected",
      "input": {
        "id": "term-leading-zero",
        "incarnationExact": "042",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Leading zero violates canonical decimal spelling."
      }
    },
    {
      "id": "positive_sign_prefix_rejected",
      "input": {
        "id": "term-positive-sign",
        "incarnationExact": "+42",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Sign prefix '+' violates canonical decimal spelling."
      }
    },
    {
      "id": "negative_sign_prefix_rejected",
      "input": {
        "id": "term-negative-sign",
        "incarnationExact": "-42",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Sign prefix '-' violates canonical positive decimal spelling."
      }
    },
    {
      "id": "whitespace_padded_exact_rejected",
      "input": {
        "id": "term-whitespace",
        "incarnationExact": " 42 ",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Surrounding whitespace violates canonical decimal spelling."
      }
    },
    {
      "id": "trailing_newline_exact_rejected",
      "input": {
        "id": "term-trailing-newline",
        "incarnationExact": "42\n",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Trailing newline strictly violates canonical decimal spelling."
      }
    },
    {
      "id": "trailing_crlf_exact_rejected",
      "input": {
        "id": "term-trailing-crlf",
        "incarnationExact": "42\r\n",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Trailing CRLF strictly violates canonical decimal spelling."
      }
    },
    {
      "id": "overflow_u64_exact_rejected",
      "input": {
        "id": "term-overflow-u64",
        "incarnationExact": "18446744073709551616",
        "incarnation": 18446744073709551615
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "18446744073709551616 exceeds 2^64 - 1."
      }
    },
    {
      "id": "floating_point_exact_rejected",
      "input": {
        "id": "term-float",
        "incarnationExact": "42.5",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Decimals/fractions not allowed in u64."
      }
    },
    {
      "id": "scientific_notation_exact_rejected",
      "input": {
        "id": "term-exponent",
        "incarnationExact": "1e5",
        "incarnation": 100000
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Scientific exponent notation not allowed."
      }
    },
    {
      "id": "non_numeric_exact_rejected",
      "input": {
        "id": "term-nan",
        "incarnationExact": "not-a-number",
        "incarnation": 42
      },
      "expected": {
        "eligible": false,
        "isCanonicalPositiveU64": false,
        "reason": "Alphabetic string is not canonical positive u64."
      }
    }
  ],
  "headersValidation": [
    {
      "id": "valid_termination_headers",
      "headers": {
        "X-DamHopper-Termination-Version": "1",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": true,
        "metadata": {
          "version": 1,
          "serverEpoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
        }
      }
    },
    {
      "id": "missing_version_header",
      "headers": {
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "unsupported"
        }
      }
    },
    {
      "id": "missing_epoch_header",
      "headers": {
        "X-DamHopper-Termination-Version": "1"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "invalidMetadata"
        }
      }
    },
    {
      "id": "unsupported_version_header",
      "headers": {
        "X-DamHopper-Termination-Version": "2",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "unsupported"
        }
      }
    },
    {
      "id": "malformed_version_header_non_integer",
      "headers": {
        "X-DamHopper-Termination-Version": "1.0",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "unsupported"
        }
      }
    },
    {
      "id": "malformed_version_header_negative",
      "headers": {
        "X-DamHopper-Termination-Version": "-1",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "unsupported"
        }
      }
    },
    {
      "id": "malformed_version_header_alphabetic",
      "headers": {
        "X-DamHopper-Termination-Version": "abc",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "unsupported"
        }
      }
    },
    {
      "id": "uppercase_epoch_header_rejected",
      "headers": {
        "X-DamHopper-Termination-Version": "1",
        "X-DamHopper-PTY-Epoch": "E7B0C36B-67DF-4F0E-B7D5-866468453483"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "invalidMetadata"
        },
        "reason": "PTY epoch must be strictly canonical lowercase hyphenated UUID."
      }
    },
    {
      "id": "epoch_header_trailing_newline_rejected",
      "headers": {
        "X-DamHopper-Termination-Version": "1",
        "X-DamHopper-PTY-Epoch": "e7b0c36b-67df-4f0e-b7d5-866468453483\n"
      },
      "expected": {
        "valid": false,
        "metadata": {
          "version": null,
          "serverEpoch": null,
          "reason": "invalidMetadata"
        },
        "reason": "PTY epoch with trailing newline strictly violates canonical UUID format."
      }
    }
  ],
  "sameIdsAcrossEpochs": [
    {
      "id": "same_id_different_epoch_target_mismatch",
      "target": {
        "profileId": "prof-1",
        "generation": 1,
        "serverEpoch": "11111111-1111-1111-1111-111111111111",
        "terminalId": "term-shared",
        "incarnation": "100"
      },
      "incomingObservation": {
        "serverEpoch": "22222222-2222-2222-2222-222222222222",
        "terminalId": "term-shared",
        "incarnationExact": "100"
      },
      "expected": {
        "targetMatch": false,
        "actionable": false,
        "reason": "Epoch change invalidates target identity even if terminal ID and incarnation match."
      }
    }
  ],
  "sixFlatTerminationStates": [
    {
      "id": "state_live",
      "input": {
        "alive": true,
        "willRestart": false,
        "terminationState": "live"
      },
      "expected": {
        "valid": true,
        "state": "live"
      }
    },
    {
      "id": "state_termination_requested",
      "input": {
        "alive": true,
        "terminationState": "terminationRequested"
      },
      "expected": {
        "valid": true,
        "state": "terminationRequested"
      }
    },
    {
      "id": "state_restart_pending",
      "input": {
        "alive": false,
        "willRestart": true,
        "terminationState": "restartPending"
      },
      "expected": {
        "valid": true,
        "state": "restartPending"
      }
    },
    {
      "id": "state_restart_cancelled",
      "input": {
        "alive": false,
        "terminationState": "restartCancelled"
      },
      "expected": {
        "valid": true,
        "state": "restartCancelled"
      }
    },
    {
      "id": "state_exited",
      "input": {
        "alive": false,
        "willRestart": false,
        "terminationState": "exited"
      },
      "expected": {
        "valid": true,
        "state": "exited"
      }
    },
    {
      "id": "state_unavailable",
      "input": {
        "alive": false,
        "targetUnavailable": true,
        "terminationState": "unavailable"
      },
      "expected": {
        "valid": true,
        "state": "unavailable"
      }
    },
    {
      "id": "state_unrecognized_never_exited_fallback",
      "input": {
        "alive": false,
        "terminationState": "some_random_state"
      },
      "expected": {
        "valid": false,
        "fallbackToExited": false,
        "reason": "Unrecognized state must never be mapped or inferred as exited."
      }
    },
    {
      "id": "state_prototype_constructor_rejected",
      "input": {
        "alive": false,
        "terminationState": "constructor"
      },
      "expected": {
        "valid": false,
        "fallbackToExited": false,
        "reason": "Inherited prototype property 'constructor' must not match valid state."
      }
    },
    {
      "id": "state_prototype_toString_rejected",
      "input": {
        "alive": false,
        "terminationState": "toString"
      },
      "expected": {
        "valid": false,
        "fallbackToExited": false,
        "reason": "Inherited prototype property 'toString' must not match valid state."
      }
    },
    {
      "id": "state_prototype_proto_rejected",
      "input": {
        "alive": false,
        "terminationState": "__proto__"
      },
      "expected": {
        "valid": false,
        "fallbackToExited": false,
        "reason": "Inherited prototype property '__proto__' must not match valid state."
      }
    }
  ],
  "terminationEndpoints": [
