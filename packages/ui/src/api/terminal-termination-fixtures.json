    {
      "id": "refusal_400_invalid_request",
      "target": {
        "profileId": "prof-1",
        "generation": 1,
        "serverEpoch": "e7b0c36b-67df-4f0e-b7d5-866468453483",
        "terminalId": "term-1",
        "incarnation": "100"
      },
      "origin": "live",
      "status": 400,
      "body": {
        "error": "Malformed termination request payload",
