{
  "name": "@dam-hopper/ui",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts && vitest run --config vitest.advisor-routing.browser.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json",
    "test:e2e:build-images": "node --experimental-strip-types e2e/fixtures/image-builder.ts",
    "test:e2e:probes": "playwright test fixtures/application-services.spec.ts"
  },
  "exports": {
    ".": "./src/embed/dam-hopper-app.tsx",
    "./styles": "./src/index.css",
    "./api/*": "./src/api/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./diagnostics-client": "./src/lib/diagnostics-client.ts",
    "./advisor": "./src/advisor/index.ts",
    "./advisor/*": "./src/advisor/*.ts"
  },
  "dependencies": {
    "@dam-hopper/browser-bridge": "workspace:*",
    "@dam-hopper/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "2.3.3",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "2.3.3",
    "@serenity-kit/opaque": "^1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.55.1",
    "react-arborist": "^3.4.3",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.67.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitest/browser-playwright": "4.1.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@tanstack/react-query": "^5.67.0",
    "jsdom": "^26.1.0",
    "playwright": "1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
