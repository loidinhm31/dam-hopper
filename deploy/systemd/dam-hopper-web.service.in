[Unit]
Description=DamHopper Static Web Host
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=dam-hopper-web
Group=dam-hopper-web
ExecStart=@RELEASE_ROOT@/bin/dam-hopper-web --root @RELEASE_ROOT@/web --host 0.0.0.0 --port 4802 --runtime-config @PUBLIC_CONFIG@ --release-version @RELEASE_VERSION@
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadOnlyPaths=@RELEASE_ROOT@
ReadOnlyPaths=@PUBLIC_CONFIG@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dam-hopper-web

[Install]
WantedBy=multi-user.target
