[Unit]
Description=DamHopper Release Boot Recovery
DefaultDependencies=no
Wants=local-fs.target
After=local-fs.target
Before=dam-hopper-api.service dam-hopper-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=@RELEASE_ROOT@/bin/dam-hopper-manager recover --boot
TimeoutSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dam-hopper-recovery

[Install]
WantedBy=multi-user.target
