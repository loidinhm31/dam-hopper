[Unit]
Description=DamHopper API Server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=@API_USER@
Group=@API_GROUP@
StateDirectory=dam-hopper
RuntimeDirectory=dam-hopper
WorkingDirectory=@API_HOME@
Environment=HOME=@API_HOME@
Environment=XDG_CONFIG_HOME=@API_HOME@/.config
Environment=RUST_LOG=info
Environment=RUST_ENV=production
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=*
Environment=DAM_HOPPER_CORS_ORIGINS=@API_ORIGINS@
EnvironmentFile=-/etc/dam-hopper/server.env
EnvironmentFile=-/etc/dam-hopper/server-safety.env
ExecStart=@RELEASE_ROOT@/bin/dam-hopper-server --config /etc/dam-hopper/dam-hopper.toml --host 0.0.0.0 --port 4801
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dam-hopper-api

[Install]
WantedBy=multi-user.target
