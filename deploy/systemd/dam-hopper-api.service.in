[Unit]
Description=DamHopper API Server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=@API_USER@
Group=@API_GROUP@
PIDFile=/run/dam-hopper/server.pid
WorkingDirectory=@API_HOME@
Environment=HOME=@API_HOME@
Environment=XDG_CONFIG_HOME=@API_HOME@/.config
Environment=RUST_LOG=info
Environment=RUST_ENV=production
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=*
Environment=DAM_HOPPER_CORS_ORIGINS=@API_ORIGINS@
EnvironmentFile=-/etc/dam-hopper/server.env
EnvironmentFile=-/etc/dam-hopper/server-safety.env
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /etc/dam-hopper/tmpfiles.d/dam-hopper-runtime.conf
ExecStartPre=+@RELEASE_ROOT@/bin/dam-hopper-manager provision-api-runtime
ExecStart=@RELEASE_ROOT@/bin/dam-hopper-server --config @API_HOME@/config.toml --host 0.0.0.0 --port 4801
ExecStartPost=/usr/bin/sh -c 'umask 0027; echo $MAINPID > /run/dam-hopper/server.pid'
ExecStopPost=/usr/bin/rm -f /run/dam-hopper/server.pid
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=false
# Resource containment. Browser sessions (Chromium trees), PTY agents and test runs started from
# terminals all live in this cgroup, so an unbounded workload can exhaust the host. MemoryHigh
# throttles and reclaims first; MemoryMax is the hard ceiling. OOMPolicy=continue keeps one OOM
# kill inside the unit from stopping the whole service. Tune with a drop-in, for example
# /etc/systemd/system/dam-hopper-api.service.d/resource-limits.conf (see deploy/systemd/
# resource-limits.conf.example for CPUQuota= and per-host sizing).
MemoryHigh=75%
MemoryMax=90%
TasksMax=16384
OOMPolicy=continue
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dam-hopper-api

[Install]
WantedBy=multi-user.target
