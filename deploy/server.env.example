# /etc/dam-hopper/server.env
# Environment variables loaded by dam-hopper-api.service.
# File permissions should be strictly restricted: chmod 600 /etc/dam-hopper/server.env

# Authentication Backend Selection:
# - Default: Unset Mongo variables select SQLite automatically (zero external services).
# - MongoDB: Uncomment BOTH MONGODB_URI and MONGODB_DATABASE to select MongoDB.
#   (Optionally set DAM_HOPPER_LITE_MODE=false to strictly enforce MongoDB and fail if missing).
# - Force SQLite: Set DAM_HOPPER_LITE_MODE=true to force SQLite even if Mongo variables are present.
#
#MONGODB_URI=mongodb://127.0.0.1:27017
#MONGODB_DATABASE=damHopper
#DAM_HOPPER_LITE_MODE=false

# SQLite database path:
# If omitted or empty, defaults to auth.db in the global DamHopper config directory (~/.config/dam-hopper/auth.db).
# In production, an absolute path on local private storage (0700 dir, 0600 file) is strongly recommended.
# Deployment limit: exactly one server process per local auth file. Do not share across multiple servers or network filesystems.
#DAM_HOPPER_AUTH_SQLITE_PATH=/var/lib/dam-hopper/auth.db
# Dedicated 32-byte MFA encryption key for encrypting TOTP secrets at rest via AES-256-GCM.
# MANDATORY in production authenticated mode (both MongoDB and SQLite lite mode).
# Generate with:
#   openssl rand -hex 32 | sudo tee /etc/dam-hopper/mfa-encryption.key > /dev/null
#   sudo chown <API_USER>:<API_GROUP> /etc/dam-hopper/mfa-encryption.key
#   sudo chmod 600 /etc/dam-hopper/mfa-encryption.key
DAM_HOPPER_MFA_KEY_FILE=/etc/dam-hopper/mfa-encryption.key

# Allowed CORS origins for the API server (comma-separated)
DAM_HOPPER_CORS_ORIGINS=http://localhost:4802
